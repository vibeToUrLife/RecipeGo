# Supabase — from dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY — never expose to the browser, never prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Push notifications (optional; left empty, they're off) — see SETUP.md,
# "Optional: Notifications". Make the pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SERVER ONLY — like a password
VAPID_PRIVATE_KEY=
# Who push services can contact, e.g. mailto:you@example.com; left empty, the
# site's own address is used.
VAPID_SUBJECT=
